# Control-plane environment — see packages/control-plane/src/main.ts for the
# full required set.
DATABASE_URL=postgresql://factory:factory@127.0.0.1:5432/factory
PORT=3000

# GitHub OAuth (login)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# GitHub App (installation tokens for git-as-bus, issue #6)
# The PATH to the PEM may ride env; the key material never does.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_FILE=

# Master key file for secret encryption (issue #8) — the PATH may ride env,
# the key material never does.
FACTORY_MASTER_KEY_FILE=

# Garage object store (issue #7)
GARAGE_S3_ENDPOINT=
GARAGE_REGION=garage
GARAGE_BUCKET=
GARAGE_ACCESS_KEY=
GARAGE_SECRET_KEY=
