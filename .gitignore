# Local agent settings — per-machine, not shared
.claude/settings.local.json

# Transient agent worktrees — they live inside the repo but are never part of it
.claude/worktrees/

# Node
node_modules/
dist/
build/
*.tsbuildinfo

# Env & key material — never committed
.env
.env.*
!.env.example
*.pem
*.key

# Backup output + generated installer form (deploy/backup, deploy/github-app)
backups/
deploy/github-app/register.html

# OS
.DS_Store

# Editor hook cache: per-session state with machine-local absolute paths
.impeccable/hook.cache.json

# Agent scratch: drafts on their way to the issue tracker (docs/agents/issue-tracker.md).
# The published issue is the artifact; the draft is not. Durable design docs belong
# in docs/design/, not here.
.scratch/
