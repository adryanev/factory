# factory self-host — environment template (spec "Packaging self-host",
# decision 7: service passwords -> env vars; key material -> files under
# deploy/keys/). Copy to the repo root as `.env`:
#
#   cp deploy/.env.example .env
#
# but do NOT fill it by hand — run deploy/init/factory-init.sh, which
# generates every value below (plus the files under deploy/keys/) with a
# real source of randomness and refuses to invent a `changeme`. The GitHub
# App fields are the one exception: they come from
# deploy/github-app/register-app.sh (the manifest flow), which writes them
# into .env for you.

# Postgres. POSTGRES_PASSWORD goes into DATABASE_URL verbatim, so it must
# contain no character that is reserved in a URL authority (`/ : @ ? # [ ]`).
# factory-init.sh generates hex for this reason.
POSTGRES_USER=factory
POSTGRES_PASSWORD=
POSTGRES_DB=factory

# Garage (object store). GARAGE_ACCESS_KEY/GARAGE_SECRET_KEY are the S3
# credentials the control plane mints presigned URLs with; GARAGE_RPC_SECRET
# signs garage-to-garage RPC (single-node, but still required by the binary).
GARAGE_RPC_SECRET=
GARAGE_ACCESS_KEY=
GARAGE_SECRET_KEY=
# Host port Garage's S3 API listens on (default 3900; override on collisions)
GARAGE_S3_HOST_PORT=3900

# Web + API public origin. What Commit Statuses link back to and what
# garage-init's CORS rule allows as the browser origin. Plain http://
# localhost works for a first local install; production needs the public
# HTTPS URL the reverse proxy terminates.
FACTORY_WEB_URL=http://localhost:3000
# Host port the control plane listens on (default 3000)
FACTORY_HTTP_PORT=3000

# The break-glass account password. Printed ONCE by factory-init.sh; rotate
# it in the UI after first login. Never commit this file.
BREAK_GLASS_PASSWORD=

# GitHub App (written by deploy/github-app/register-app.sh)
GITHUB_APP_ID=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
