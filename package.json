{
  "name": "factory",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.14.0",
  "scripts": {
    "typecheck": "pnpm -r run typecheck",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "test": "pnpm -r run test",
    "generate:openapi": "pnpm --filter @factory/control-plane run generate:openapi",
    "check:openapi": "pnpm --filter @factory/control-plane run check:openapi",
    "check:packaging": "sh deploy/check/invariants.sh",
    "build:runner-tarball": "sh deploy/runner/build-runner-tarball.sh"
  },
  "devDependencies": {
    "eslint": "^10.8.0",
    "typescript-eslint": "^8.66.0"
  }
}
