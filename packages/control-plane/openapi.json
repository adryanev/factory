    "/projects/{id}/runs": {
      "post": {
        "summary": "Triggers a Pipeline over a ref. Reads the definition (and every prompt file it references) from that ref, validates, and — if valid — materializes the Run and its initial Graph in one transaction. Project `member`.",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Client-generated Run id; a repeat of the same id is rejected by the primary key."
                  },
                  "repositoryId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "pipelinePath": {
                    "type": "string",
                    "minLength": 1
                  },
                  "refBranch": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "id",
                  "repositoryId",
                  "pipelinePath",
                  "refBranch"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created. `stepRuns` holds the Steps materialized up front — see the Run's `definition` for the rest of the Graph's shape.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "run": {
                      "$ref": "#/components/schemas/Run"
                    },
                    "stepRuns": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/StepRun"
                      }
                    }
                  },
                  "required": [
                    "run",
                    "stepRuns"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Rejected before any row was written: an unknown ref, a missing definition or prompt file, a definition that fails validation, the combined size over the inline-storage limit, an unknown Step repo:, or a repeated Run id.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "code",
                    "message"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Not logged in.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "code",
                    "message"
                  ]
                }
              }
            }
          },
          "403": {
            "description": "Not a Project member.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "code",
                    "message"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "No such Project or Repository.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "code",
                    "message"
                  ]
                }
              }
            }
          }
        }
      },
      "get": {
        "summary": "Runs for a Project, newest first. Keyset pagination on id — no total count. `inFlight=true` filters ended_at IS NULL; `outcome=` filters a final verdict; the two are never combined.",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "id",
            "in": "path"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "cursor",
            "in": "query"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "limit",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "true"
              ]
            },
            "required": false,
            "name": "inFlight",
            "in": "query"
          },
          {
