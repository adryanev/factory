{
  "openapi": "3.0.3",
  "info": {
    "title": "Factory Control Plane API",
    "version": "0.0.0",
    "description": "REST surface: web <-> control plane. Domain terms follow CONTEXT.md; the full contract is in .scratch/distributed-software-factory/spec.md."
  },
  "components": {
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          },
          "time": {
            "type": "string",
            "example": "2026-08-03T00:00:00.000Z"
          }
        },
        "required": [
          "status",
          "time"
        ]
      },
      "ReadyResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ready"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "ScaffoldProbe": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded"
            ]
          },
          "message": {
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "status",
          "message",
          "createdAt"
        ]
      },
      "CreateScaffoldProbeRequest": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Client-generated id with the `probe` prefix."
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "required": [
          "id",
          "message"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Liveness probe. Never touches Postgres.",
        "responses": {
          "200": {
            "description": "The process is running.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "summary": "Readiness probe. Confirms Postgres is reachable.",
        "responses": {
          "200": {
            "description": "Postgres answered.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyResponse"
                }
              }
            }
          },
          "503": {
            "description": "Postgres did not answer.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "code",
                    "message"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/scaffold-probes": {
      "post": {
        "summary": "Writes one row to Postgres using a client-generated id.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateScaffoldProbeRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Row written.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScaffoldProbe"
                }
              }
            }
          },
          "400": {
            "description": "Malformed id.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "code",
                    "message"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/scaffold-probes/{id}": {
      "get": {
        "summary": "Reads one row back from Postgres.",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Row found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScaffoldProbe"
                }
              }
            }
          },
          "404": {
            "description": "No such row.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "code",
                    "message"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
